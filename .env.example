# Copy to .env (git-ignored). Never commit real keys.
ANTHROPIC_API_KEY=
# Claude-generated labels may NOT be used as training targets without prior written
# authorization from Anthropic (AUP: "Use outputs to train an AI model ... without prior
# authorization"). Set this ONLY to a reference for that written authorization; it is the
# only thing that makes the preflight classify Claude outputs as "permitted" (docs/AI_DATA_POLICY.md).
FILMLOOK_ANTHROPIC_TRAINING_AUTHORIZATION_REF=
UNSPLASH_ACCESS_KEY=
HF_TOKEN=
